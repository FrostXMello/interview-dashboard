# Supabase (required for connected/production mode)
# Must be a real project URL plus either:
# - a publishable key (sb_publishable_...), or
# - a legacy JWT anon key (three segments starting with eyJ).
# Never put a service_role JWT or sb_secret_ key in NEXT_PUBLIC_*.
# If unset or invalid, the app runs in offline-demo mode with synthetic data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional override: demo | offline-demo | connected | production
# NEXT_PUBLIC_APP_MODE=demo

# Server-only. Used by `npm run verify:rls`. NEVER prefix with NEXT_PUBLIC. NEVER commit.
# SUPABASE_SERVICE_ROLE_KEY=
# VERIFY_TEST_PASSWORD=
#
# Server-only Super Admin provisioning. Used by `npm run provision:super-admin`.
# SUPER_ADMIN_PHONE=
# SUPER_ADMIN_PASSWORD=
# SUPER_ADMIN_DISPLAY_NAME=
# SUPER_ADMIN_DISPLAY_TITLE=
